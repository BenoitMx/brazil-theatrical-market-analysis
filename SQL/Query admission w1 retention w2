CREATE OR REPLACE TABLE `Ancine.admission_w1_screen_retention` AS

WITH films AS (
  SELECT
    Title,
    release_date_clean,
    MAX(IF(exploitation_week = 1, screens_at_release, NULL)) AS screens_w1,
    MAX(IF(exploitation_week = 2, screens_at_release, NULL)) AS screens_w2,
    MAX(IF(exploitation_week = 1, week_admissions, NULL)) AS admissions_w1

  FROM `Ancine.true_first_week`

  WHERE exploitation_week IN (1, 2)

  GROUP BY
    Title,
    release_date_clean
),

metrics AS (
  SELECT
    *,

    SAFE_DIVIDE(
      admissions_w1,
      screens_w1
    ) AS admissions_per_screen_w1,

    100 * SAFE_DIVIDE(
      screens_w2 - screens_w1,
      screens_w1
    ) AS screen_retention_w2_pct

  FROM films

  WHERE screens_w1 > 0
    AND screens_w2 IS NOT NULL
    AND admissions_w1 IS NOT NULL
),

admission_groups AS (
  SELECT
    *,
    FLOOR(admissions_per_screen_w1 / 10) * 10 AS admission_group_start
  FROM metrics

  # Exclude extremes
  WHERE screen_retention_w2_pct BETWEEN -100 AND 150
)

SELECT
  admission_group_start,
  admission_group_start + 10 AS admission_group_end,
  CONCAT(
    CAST(admission_group_start AS STRING),
    '-',
    CAST(admission_group_start + 10 AS STRING)
  ) AS admission_group,
  COUNT(*) AS number_of_films,
  AVG(admissions_per_screen_w1) AS avg_admissions_per_screen_w1,
  AVG(screen_retention_w2_pct) AS avg_screen_retention_w2_pct

FROM admission_groups
GROUP BY admission_group_start
ORDER BY admission_group_start;
